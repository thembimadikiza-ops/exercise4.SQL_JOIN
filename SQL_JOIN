--Step 1: Create Catalog
CREATE CATALOG IF NOT EXISTS brightlearn;

--Step 2: Create schema
CREATE SCHEMA IF NOT EXISTS brightlearn.sql_joins;
--Step 3: Create the table
CREATE TABLE IF NOT EXISTS brightlearn.sql_joins.users (
    user_id INT,
    user_name STRING,
    country STRING
);
CREATE TABLE IF NOT EXISTS brightlearn.sql_joins.plans (
    plan_id INT,
    plan_name STRING,
    plan_id INT,
    start_date DATE
);
DROP TABLE brightlearn.sql_joins.subscriptions;
CREATE TABLE IF NOT EXISTS brightlearn.sql_joins.subscriptions (
    subscription_id INT,
    user_id INT,
    plan_id INT,
    start_date DATE
);
CREATE TABLE IF NOT EXISTS brightlearn.sql_joins.shows (
    show_id INT,
    show_title STRING,
    genre STRING
);
CREATE TABLE IF NOT EXISTS brightlearn.sql_joins.viewing_sessions (
    session_id INT,
    user_id INT, 
    show_id INT,
    watch_mintutes DATE
);
