CREATE OR REPLACE TABLE brightlearn.sql_joins.subscriptions AS
SELECT DISTINCT
    subscription_id,
    user_id,
    plan_id,
    start_date
FROM brightlearn.sql_joins.subscriptions;
--question 2: 
SELECT DISTINCT
s.subscription_id,
s.user_id,
p.plan_name,
p.monthly_price
FROM brightlearn.sql_joins.subscriptions s
INNER JOIN brightlearn.sql_joins.plans p
ON s.plan_id = p.plan_id
ORDER BY s.subscription_id;

--question 3: Show every viewing session that has a matching show. Include the show title and 
--genre.

SELECT DISTINCT
v.session_id,
v.user_id,
s.show_title,
s.genre,
v.watch_minutes
FROM brightlearn.sql_joins.viewing_sessions v
INNER JOIN brightlearn.sql_joins.shows s
ON v.show_id = s.show_id;
--Question 4:Show every viewing session with the user who watched it. Only show sessions with a 
--matching user 

SELECT DISTINCT
u.user_name,
u.country,
v.session_id,
v.show_id,
v.watch_minutes
FROM brightlearn.sql_joins.users u
INNER JOIN brightlearn.sql_joins.viewing_sessions v
ON u.user_id = v.user_id;

--Question 5: Show users along with their subscriptions, the plan name, and the price. Use only users 
--who have both a subscription and a valid plan.

SELECT DISTINCT
u.user_name,
u.country,
p.plan_name,
p.monthly_price,
s.start_date
FROM brightlearn.sql_joins.users u
INNER JOIN brightlearn.sql_joins.subscriptions s
ON u.user_id = s.user_id
INNER JOIN brightlearn.sql_joins.plans p
ON s.plan_id = p.plan_id;

--Question 6:Show every user and any subscriptions they have. Users without subscriptions must still 
--appear.
SELECT DISTINCT
u.user_id,
u.user_name,
s.subscription_id,
s.start_date
FROM brightlearn.sql_joins.users u
LEFT JOIN brightlearn.sql_joins.subscriptions s
ON u.user_id = s.user_id;

--question 7: Show every plan and the subscriptions on it. Plans with no subscribers must still 
--appear.
SELECT DISTINCT
p.plan_id,
p.plan_name,
s.subscription_id,
s.user_id
FROM brightlearn.sql_joins.plans p
LEFT JOIN brightlearn.sql_joins.subscriptions s
ON p.plan_id = s.plan_id;

--Question 8:Show every show and any viewing sessions on it. Shows that were never watched must 
--still appear. 

SELECT DISTINCT
s.show_id,
s.show_title,
v.session_id,
v.watch_minutes
FROM brightlearn.sql_joins.shows s
LEFT JOIN brightlearn.sql_joins.viewing_sessions v
ON s.show_id = v.show_id;

--Question 9:Show every viewing session and the user who watched it. Sessions referencing users 
--that do not exist must still appear (with NULL user details).
SELECT DISTINCT
v.session_id,
v.show_id,
v.watch_minutes,
u.user_id,
u.user_name,
u.country
FROM brightlearn.sql_joins.viewing_sessions v
LEFT JOIN brightlearn.sql_joins.users u
ON v.user_id = u.user_id

--Question 10 Show every user, the plan they are on (if any), and the monthly price. Users without a 
--subscription must still appear.

SELECT DISTINCT 
u.user_name,
u.country,
p.plan_name,
p.monthly_price
FROM brightlearn.sql_joins.users u
LEFT JOIN brightlearn.sql_joins.subscriptions s
ON u.user_id = s.user_id
LEFT JOIN brightlearn.sql_joins.plans p
ON s.plan_id = p.plan_id;

--question 11:Show every user and every subscription, including users without subscriptions AND 
--subscriptions referencing users that do not exist. 

SELECT DISTINCT
u.user_id,
u.user_name,
s.subscription_id,
s.start_date
FROM brightlearn.sql_joins.users u
FULL OUTER JOIN brightlearn.sql_joins.subscriptions s
ON u.user_id = s.user_id;

--Question 12:Show every plan and every subscription, including plans without subscribers AND any subscription --referencing a plan that does not exist. 
SELECT DISTINCT
p.plan_id,
p.plan_name,
s.subscription_id,
s.user_id
FROM brightlearn.sql_joins.plans p
FULL OUTER JOIN brightlearn.sql_joins.subscriptions s
ON p.plan_id = s.plan_id; 
 
--Question 13:Show every show and every viewing session, including shows that were never watched 
--AND sessions referencing shows that do not exist. 
SELECT DISTINCT
s.show_id,
s.show_title,
v.session_id,
v.watch_minutes
FROM brightlearn.sql_joins.shows s
FULL OUTER JOIN brightlearn.sql_joins.viewing_sessions v
ON s.show_id = v.show_id;

--Question 14:Show every user and every viewing session, including users with no sessions AND 
--sessions referencing users who do not exist 
SELECT DISTINCT
u.user_id,
u.user_name,
v.session_id,
v.show_id,
v.watch_minutes
FROM brightlearn.sql_joins.users u
FULL OUTER JOIN brightlearn.sql_joins.viewing_sessions v
ON u.user_id = v.user_id;

--Question 15:Show every user, every subscription, and every plan in one query — using FULL OUTER 
--JOIN throughout. This is the hardest question — get all gaps visible at once. 
SELECT DISTINCT
u.user_id,
u.user_name,
s.subscription_id,
p.plan_id,
p.plan_name
FROM brightlearn.sql_joins.users u
FULL OUTER JOIN brightlearn.sql_joins.subscriptions s
ON u.user_id = s.user_id
FULL OUTER JOIN brightlearn.sql_joins.plans p
ON s.plan_id = p.plan_id;
